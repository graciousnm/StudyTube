# StudyTube environment example — copy to `.env` and fill in real values.
# Never commit real credentials. `DATABASE_URL` uses a plain filesystem path
# (SQLite). `YOUTUBE_API_KEY` is server-side only; required for live search.

DATABASE_URL=./data/learning.sqlite

YOUTUBE_API_KEY=your_youtube_api_key_here

# OpenRouter API key for AI outline generation. Optional — when missing, the
# "New Course" dialog shows only the manual option.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Override the default AI model (meta-llama/llama-3.3-70b-instruct).
# AI_MODEL=meta-llama/llama-3.3-70b-instruct